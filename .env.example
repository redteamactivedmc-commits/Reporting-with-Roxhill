# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — add it to .gitignore immediately.
# ─────────────────────────────────────────────────────────────────────────────

# ── Microsoft Azure credentials ───────────────────────────────────────────────
# Get these from: portal.azure.com → App registrations → your app
# Your IT admin or Varun may need to create this app registration.

MS_TENANT_ID=your-tenant-id-here
MS_CLIENT_ID=your-client-id-here
MS_CLIENT_SECRET=your-client-secret-here

# The mailbox the agent reads Roxhill alerts from
# This should be YOUR email address (or a shared inbox)
MS_USER_EMAIL=lea@activedmc.com

# ─────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS
# ─────────────────────────────────────────────────────────────────────────────
#
# Step 1 — Create an Azure App Registration (one-time, needs IT admin)
#   1. Go to portal.azure.com
#   2. Search "App registrations" → New registration
#   3. Name it something like "ADMC Roxhill Agent"
#   4. Under "API permissions" add:
#        Microsoft Graph → Application permissions → Mail.Read
#   5. Grant admin consent for these permissions
#   6. Go to "Certificates & secrets" → New client secret
#   7. Copy the Tenant ID, Client ID, and Client Secret into this file
#
# Step 2 — Install Python dependencies
#   pip install requests beautifulsoup4 lxml python-dotenv
#   pip install python-docx openpyxl selenium webdriver-manager Pillow
#   (the last line is for the existing media_monitor screenshot system)
#
# Step 3 — Run the agent
#   python roxhill_agent.py --dry-run          # test without creating files
#   python roxhill_agent.py                    # full run, all clients
#   python roxhill_agent.py --client uipath    # UiPath only
#
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Roxhill alert emails must be received at the mailbox set above.
# If your alerts go to a shared inbox (e.g. pr@activedmc.com), set that address
# as MS_USER_EMAIL and ensure your app has delegated or shared mailbox access.
# ─────────────────────────────────────────────────────────────────────────────
